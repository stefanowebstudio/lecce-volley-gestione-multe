# Obbligatoria: public = link condiviso senza accesso; admin = sito privato per le modifiche.
# Un valore mancante o diverso genera una schermata di configurazione e non avvia l'app.
VITE_APP_MODE=public
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Comma separated Firebase Auth UIDs allowed to see the admin area.
# Use the UID of your Google account. Firestore additionally requires a
# manually provisioned admins/{uid} document.
VITE_ADMIN_UIDS=
